# ============================================================
# Live Fuel Tracker – Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# Everything marked "FREE – no key needed" works out of the box.

# ── Database (optional) ────────────────────────────────────
# PostgreSQL connection string.
# On Railway: use the Postgres plugin → variable auto-injected as DATABASE_URL
# If not set, app falls back to public/countries-data.json sample data.
DATABASE_URL=postgresql://user:password@localhost:5432/energy_resources

# ── EIA – U.S. Energy Information Administration ───────────
# FREE – register at https://www.eia.gov/opendata/register.php (instant, no CC)
# Unlocks: US weekly crude/gasoline/distillate stocks, retail prices,
#          US proved reserves, monthly production, international oil data
# Without this key: OWID, World Bank, MARAD, gCaptain feeds still work
EIA_API_KEY=

# ── IEA – International Energy Agency ─────────────────────
# FREE registration – https://data.iea.org/ (email required, approved same day)
# Unlocks: OECD monthly oil stocks, European inventory data
IEA_API_KEY=

# ── Twitter / X  ──────────────────────────────────────────
# NOT REQUIRED – maritime disruption data is available without it via:
#   • Nitter RSS (public Twitter mirrors): @WindwardAI, @MarineTraffic, @Portwatch_IMF
#   • MARAD official US Maritime Administration advisories (free, no key)
#   • gCaptain RSS maritime news feed (free, no key)
#   • MarineTraffic blog RSS (free, no key)
#
# If you do have an X Bearer Token, add it here for direct API access:
# X_BEARER_TOKEN=

# ── Cron / Scraper security ────────────────────────────────
# Protects POST /api/scraper/run in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_secure_random_token_here
NEXT_PUBLIC_CRON_SECRET=your_secure_random_token_here

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development

# Railway sets PORT automatically – do not set manually on Railway
# PORT=3000

# ============================================================
# FREE APIs that need NO environment variable at all:
# ============================================================
# • Our World in Data (OWID) CSV – global energy production + reserves
#   https://github.com/owid/energy-data
#
# • World Bank API – Brent crude price, energy indicators
#   https://data.worldbank.org
#
# • Carbon Intensity API – UK real-time electricity generation mix
#   https://api.carbonintensity.org.uk
#
# • MARAD Maritime Security Communications with Industry (MSCI)
#   https://www.maritime.dot.gov/msci/maritime-advisories
#
# • gCaptain maritime news RSS
#   https://gcaptain.com/feed/
#
# • Nitter RSS (Twitter mirror, no auth needed)
#   https://nitter.privacydev.net/WindwardAI/rss
# ============================================================
