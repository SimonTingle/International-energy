# Database Configuration
# Optional: For local development use PostgreSQL
# For Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres
# If not set, app uses sample data from public/countries-data.json
DATABASE_URL=postgresql://user:password@localhost:5432/energy_resources

# Data Source APIs (All FREE, No Credit Card Required)

# Optional: EIA API Key (Free)
# Register at https://www.eia.gov/opendata/register/
# Provides US energy production and consumption data
EIA_API_KEY=

# Optional: World Bank API (Completely Free, No Key Needed)
# Provides renewable energy and environmental indicators
# API endpoint: https://api.worldbank.org/v2/country/*/indicator/*
# Already integrated and works without configuration

# Vercel Cron Job Security (for scheduling scrapers)
# Generate a secure token for protecting cron endpoints
CRON_SECRET=your_secure_random_token_here

# Environment
NODE_ENV=development
