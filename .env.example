# Database Configuration
# For Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres
DATABASE_URL=postgresql://user:password@localhost:5432/energy_resources

# Mapbox Configuration
# Get your token from https://account.mapbox.com/tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Data Source APIs
# IEA API Key - Register at https://www.iea.org/data-and-statistics
IEA_API_KEY=your_iea_api_key

# EIA API Key - Get from https://www.eia.gov/opendata/
EIA_API_KEY=your_eia_api_key

# Vercel Cron Job Security
# Generate a secure token for protecting cron endpoints
CRON_SECRET=your_secure_cron_token

# Environment
NODE_ENV=development
